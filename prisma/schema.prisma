// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
   
}
model Profile {
  id                 String      @id @db.Uuid
  name               String?
  primaryLanguage    String      @default("kn")
  state              String?
  district           String?
  pincode            String?
  farmSize           String?
  crops              String[]    @default([])
  onboardingComplete Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  diagnoses          Diagnosis[]

  @@map("profiles")
}

model Crop {
  id            String   @id
  nameEn        String
  nameHi        String?
  nameKn        String?
  supportedInV1 Boolean  @default(false)

  @@map("crops")
}

model Disease {
  id                  String   @id
  cropId              String
  nameEn              String
  nameHi              String?
  nameKn              String?
  description         String?
  symptoms            String[] @default([])
  treatmentSteps      Json?
  recommendedProducts Json?

  @@map("diseases")
}

model Diagnosis {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  profile         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl        String
  voiceDescription String?
  cropDetected    String?
  diseaseDetected String?
  confidence      Float?
  severity        String?
  treatmentPlan   Json?
  status          String   @default("processing")
  userFeedback    String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("diagnoses")
}